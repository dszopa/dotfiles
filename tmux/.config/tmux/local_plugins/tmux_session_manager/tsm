#!/bin/bash

set -euo pipefail

usage() {
  cat <<'EOF' >&2
Usage: tsm <command> [args]

Commands:
  slot-1            Switch to session in TMUX_SESSION_SLOT_1
  slot-2            Switch to session in TMUX_SESSION_SLOT_2
  slot-3            Switch to session in TMUX_SESSION_SLOT_3
  slot-4            Switch to session in TMUX_SESSION_SLOT_4
  slot-5            Switch to session in TMUX_SESSION_SLOT_5
  slot-6            Switch to session in TMUX_SESSION_SLOT_6
  slot-7            Switch to session in TMUX_SESSION_SLOT_7
  slot-8            Switch to session in TMUX_SESSION_SLOT_8
  slot-9            Switch to session in TMUX_SESSION_SLOT_9
  slot-10           Switch to session in TMUX_SESSION_SLOT_10
  open              Open session manager popup
  pick-dir <path>   Pick directory and switch/create session (requires path)
EOF
}

# If there are no arguments, print usage and exit with error code.
if [ "$#" -lt 1 ]; then
  usage
  exit 1
fi

command_name="$1"

switch_to_slot() {
  slot_number="$1"
  env_name="TMUX_SESSION_SLOT_${slot_number}"
  session_target="$(tmux show-environment -g "$env_name" 2>/dev/null | sed "s/^${env_name}=//")"
  if [ -z "$session_target" ] || [ "$session_target" = "unset" ]; then
    printf 'Error: %s is unset.\n' "$env_name" >&2
    exit 1
  fi
  tmux switch-client -t "$session_target"
}

case "$command_name" in
  slot-1)
    switch_to_slot 1
    ;;
  slot-2)
    switch_to_slot 2
    ;;
  slot-3)
    switch_to_slot 3
    ;;
  slot-4)
    switch_to_slot 4
    ;;
  slot-5)
    switch_to_slot 5
    ;;
  slot-6)
    switch_to_slot 6
    ;;
  slot-7)
    switch_to_slot 7
    ;;
  slot-8)
    switch_to_slot 8
    ;;
  slot-9)
    switch_to_slot 9
    ;;
  slot-10)
    switch_to_slot 10
    ;;
  open)
    tmux display-popup -E -w '100%' -h '100%' ~/.config/tmux/local_plugins/tmux_session_manager/tmux_session_manager.sh
    ;;
  pick-dir)
    if [ "$#" -ne 2 ]; then
      printf 'Error: pick-dir requires exactly one path argument.\n' >&2
      usage
      exit 1
    fi
    ~/.config/tmux/local_plugins/tmux_session_manager/switch_coding_session.sh "$2"
    ;;
  *)
    usage
    exit 1
    ;;
esac
