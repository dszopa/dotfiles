#!/bin/bash

set -euo pipefail

usage() {
  cat <<'EOF' >&2
Usage: tsm <command>

Commands:
  session-u   Switch to session in TMUX_SESSION_U
  session-i   Switch to session in TMUX_SESSION_I
  session-o   Switch to session in TMUX_SESSION_O
  session-p   Switch to session in TMUX_SESSION_P
  open        Open session manager popup
  coding      Open coding directory picker popup
EOF
}

# If there is not exactly one argument, print usage and exit with error code.
if [ "$#" -ne 1 ]; then
  usage
  exit 1
fi

command_name="$1"

case "$command_name" in
  session-u)
    session_target="$(tmux show-environment -g TMUX_SESSION_U 2>/dev/null | sed 's/^TMUX_SESSION_U=//')"
    if [ -z "$session_target" ]; then
      printf 'Error: TMUX_SESSION_U is unset.\n' >&2
      exit 1
    fi
    tmux switch-client -t "$session_target"
    ;;
  session-i)
    session_target="$(tmux show-environment -g TMUX_SESSION_I 2>/dev/null | sed 's/^TMUX_SESSION_I=//')"
    if [ -z "$session_target" ]; then
      printf 'Error: TMUX_SESSION_I is unset.\n' >&2
      exit 1
    fi
    tmux switch-client -t "$session_target"
    ;;
  session-o)
    session_target="$(tmux show-environment -g TMUX_SESSION_O 2>/dev/null | sed 's/^TMUX_SESSION_O=//')"
    if [ -z "$session_target" ]; then
      printf 'Error: TMUX_SESSION_O is unset.\n' >&2
      exit 1
    fi
    tmux switch-client -t "$session_target"
    ;;
  session-p)
    session_target="$(tmux show-environment -g TMUX_SESSION_P 2>/dev/null | sed 's/^TMUX_SESSION_P=//')"
    if [ -z "$session_target" ]; then
      printf 'Error: TMUX_SESSION_P is unset.\n' >&2
      exit 1
    fi
    tmux switch-client -t "$session_target"
    ;;
  open)
    tmux display-popup -E -w '100%' -h '100%' ~/.config/tmux/local_plugins/tmux_session_manager/tmux_session_manager.sh
    ;;
  coding)
    tmux display-popup -E -w '100%' -h '100%' ~/.config/tmux/local_plugins/tmux_session_manager/switch_coding_session.sh
    ;;
  *)
    usage
    exit 1
    ;;
esac
